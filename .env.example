# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copie este archivo a `.env.local` y complete los valores:
#   cp .env.example .env.local
# `.env.local` está en .gitignore: nunca suba claves al repositorio.
# En Vercel, configure estas variables por entorno (Preview / Production).
# ─────────────────────────────────────────────────────────────

# ── Servidor (secretas) ─ solo se leen en la ruta /api/quote-agent.
#    No llevan el prefijo NEXT_PUBLIC_, así que nunca llegan al navegador.

# Proveedor de IA del asistente: "anthropic" o "gemini".
# Si se omite, se usa el que tenga clave (Claude primero).
# Sin ninguna clave, el asistente funciona en modo guiado (sin IA).
AI_PROVIDER=

# Claude (Anthropic): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Peticiones por minuto permitidas por IP al asistente (opcional).
QUOTE_AGENT_RATE_LIMIT=20

# ── Públicas ─ se incrustan en el bundle del cliente. Solo datos no sensibles.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=ventas@euroheaters.mx
NEXT_PUBLIC_CONTACT_PHONE=+525557757515
NEXT_PUBLIC_CONTACT_PHONE_LABEL=(55) 5775 7515
# Número de WhatsApp en formato internacional, solo dígitos.
NEXT_PUBLIC_CONTACT_WHATSAPP=525557757515

# Redes sociales oficiales (si se omiten se usan valores de ejemplo).
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
